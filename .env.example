# =============================================================
# CodeTogether — Environment Configuration Template
# Copy this file to .env and fill in values for your deployment.
# NEVER commit .env with real secrets to GitHub!
# =============================================================

# --- Backend Server Configuration ---
PORT=5001
NODE_ENV=production

# The public URL of your Vercel frontend (used for CORS and socket origins)
# Can be a single URL or comma-separated list (e.g. https://codetogether.vercel.app,http://localhost:5173)
FRONTEND_URL=https://codetogether.vercel.app

# MongoDB Atlas Connection URI
# Obtain from MongoDB Atlas -> Connect -> Connect your application
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/codetogether?retryWrites=true&w=majority

# Session / JWT Encryption Secret (32+ random characters)
SESSION_SECRET=change-this-to-a-secure-random-secret-key-in-production

# --- Frontend Client Configuration (Vite) ---
# Set these in your Vercel Dashboard -> Settings -> Environment Variables
VITE_API_URL=https://your-backend-service.up.railway.app
VITE_SOCKET_URL=https://your-backend-service.up.railway.app

# --- Sandbox Execution Limits & Storage ---
MAX_PROJECT_SIZE_MB=50
MAX_FILES_COUNT=500
SANDBOX_TIMEOUT_MS=1800000
