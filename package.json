{
  "name": "codetogether-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/server.js",
    "free-ports": "node -e \"import('child_process').then(({execSync})=>{[5001,5173].forEach(p=>{try{const out=execSync('netstat -ano | findstr :'+p).toString(); out.split(/\\r?\\n/).forEach(l=>{if(/LISTENING/i.test(l)){const pid=l.trim().split(/\\s+/).pop(); if(pid&&pid!=='0'&&pid!==process.pid.toString()) execSync('taskkill /F /PID '+pid);}}); }catch(e){}}); console.log('Ports 5001 & 5173 checked and freed.');});\"",
    "tunnel": "localtunnel --port 5173",
    "fullstack": "concurrently -n \"SERVER,CLIENT\" -c \"magenta,cyan\" \"node server/server.js\" \"vite\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node run-all-tests.js"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.16.0",
    "mongoose": "^9.12.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^2.5.5",
    "y-monaco": "^0.1.6",
    "y-webrtc": "^10.3.0",
    "yjs": "^13.6.23"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.7",
    "localtunnel": "^2.0.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "vite": "^6.0.1"
  }
}
